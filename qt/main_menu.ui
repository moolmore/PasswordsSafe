    <property name="styleSheet">
     <string notr="true">/* Настройка самого списка (фона) */
QListWidget {
     /* Темный фон списка */
	background-color: rgba(255, 255, 255, 0);
    padding: 5px;              /* Отступ от краев до элементов */
    color: #ffffff;            /* Цвет текста по умолчанию */
}

/* Настройка всех элементов списка в обычном состоянии */
QListWidget::item {
    
	
	background-color: qlineargradient(spread:pad, x1:0.002, y1:0, x2:0, y2:1, stop:0 rgba(98, 98, 98, 255), stop:1 rgba(85, 85, 85, 255));
                /* Цвет текста элемента */
	color: rgb(225, 225, 225);
    padding: 8px 12px;         /* Внутренние отступы (высота и ширина) */
    margin-bottom: 4px;        /* Расстояние между элементами */
    border-radius: 15px;        /* Скругление углов элементов */
}

/* Настройка элементов при наведении курсора (ховер) */
QListWidget::item:hover {
	background-color: rgb(98, 98, 98);
	border: 1px solid rgb(110, 110, 110);

}

/* Настройка выбранного элемента */
QListWidget::item:selected {
    /* Цвет фона выбранного элемента */
	
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(93, 93, 93, 255), stop:1 rgba(106, 137, 115, 255));
	
}




</string>
    </property>
    <property name="verticalScrollBarPolicy">
     <enum>Qt::ScrollBarPolicy::ScrollBarAlwaysOff</enum>
    </property>
    <property name="horizontalScrollBarPolicy">
     <enum>Qt::ScrollBarPolicy::ScrollBarAlwaysOff</enum>
    </property>
