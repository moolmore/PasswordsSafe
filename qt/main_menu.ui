     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; font-weight:700; color:#a1c292;&quot;&gt;Welcome to Passwords safe&lt;/span&gt;&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;&lt;span style=&quot; color:#b5b5b5;&quot;&gt;This is a cryptographic manager of passwords&lt;br/&gt;&lt;br/&gt;&lt;/span&gt;&lt;span style=&quot; text-decoration: underline; color:#b5b5b5;&quot;&gt;Open&lt;/span&gt;&lt;span style=&quot; color:#b5b5b5;&quot;&gt; a file or &lt;/span&gt;&lt;span style=&quot; text-decoration: underline; color:#b5b5b5;&quot;&gt;create new&lt;/span&gt;&lt;span style=&quot; color:#b5b5b5;&quot;&gt; passwords list&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
