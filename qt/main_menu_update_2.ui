    <property name="styleSheet">
     <string notr="true">/* Настройка самого списка (фона) */
QListWidget {
     /* Темный фон списка */
	
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 rgba(77, 77, 77, 255), stop:0.244318 rgba(71, 71, 69, 255));
    padding: 7px;              /* Отступ от краев до элементов */
    color: #ffffff;            /* Цвет текста по умолчанию */
	border-radius: 15px;
}

/* Настройка всех элементов списка в обычном состоянии */
QListWidget::item {
    
	
	background-color: qlineargradient(spread:pad, x1:0.002, y1:0, x2:0, y2:1, stop:0 rgba(98, 98, 98, 255), stop:1 rgba(85, 85, 85, 255));
                /* Цвет текста элемента */
	color: rgb(225, 225, 225);
    padding: 8px 12px;         /* Внутренние отступы (высота и ширина) */
    margin-bottom: 4px;        /* Расстояние между элементами */
	margin-right: 4px;
    border-radius: 15px;        /* Скругление углов элементов */
}

/* Настройка элементов при наведении курсора (ховер) */
QListWidget::item:hover {
	background-color: rgb(98, 98, 98);
	border: 1px solid rgb(110, 110, 110);

}

/* Настройка выбранного элемента */
QListWidget::item:selected {
    /* Цвет фона выбранного элемента */
	
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(93, 93, 93, 255), stop:1 rgba(106, 137, 115, 255));
	
}




/* ################################## SCROLL BAR ################

/* Настройки самой полосы прокрутки: убираем фон и задаем ширину */
QListView QScrollBar:vertical {
	background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 rgba(77, 77, 77, 255), stop:0.244318 rgba(71, 71, 69, 255));
    width: 7px;
    margin: 0px;
	
}

/* Настройки бегунка: задаем цвет, скругление и убираем рамки */
QListView QScrollBar::handle:vertical {
    
	background: rgb(109, 109, 109); 
    min-height: 20px;
    border-radius: 3px;   /* Скругление (половина от ширины делает его овальным) */
    border: none;
}

/* Цвет бегунка при наведении мыши */
QListView QScrollBar::handle:vertical:hover {
    background: rgb(114, 136, 100); /* Цвет бегунка (можно изменить) */
}

/* Полностью скрываем стрелочки сверху и снизу */
QListView QScrollBar::add-line:vertical, 
QListView QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
    subcontrol-origin: margin;
}

/* Убираем возможные остаточные элементы фона */
QListView QScrollBar::add-page:vertical, 
QListView QScrollBar::sub-page:vertical {
    background: none;
}
</string>
